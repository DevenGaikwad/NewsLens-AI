# Safe examples only. Core features require no API key.
NEWSLENS_MODEL_PATH=models/fake_news_pipeline.joblib
# Private dataset-derived calibration parameters; exclude from public packages.
NEWSLENS_CALIBRATION_PATH=models/confidence_calibration.json
# "session" is required for public multi-user hosting. Use "persistent" only
# for a trusted, single-user local runtime.
NEWSLENS_HISTORY_MODE=session
NEWSLENS_DATABASE_PATH=database/analysis_history.db
NEWSLENS_ABSTRACTIVE_MODEL=sshleifer/distilbart-cnn-6-6
HF_HOME=models/transformer_cache
